---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import heroImage from "../assets/poetry-hero.webp";
import { ui, type Language } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  language?: Language;
  alternateHref?: string;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
}

const language: Language = Astro.props.language ?? "ru";
const siteTitle = "Michael Lazebny's favorite poems";
const title = Astro.props.title ?? siteTitle;
const description = Astro.props.description ?? ui[language].description;
const alternateHref = Astro.props.alternateHref ?? (language === "en" ? "/" : "/en");
const pageTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const copy = ui[language];
const englishHref = language === "en" ? Astro.url.pathname : alternateHref;
const russianHref = language === "ru" ? Astro.url.pathname : alternateHref;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImageSource = Astro.props.socialImage ?? heroImage;
const socialImage = await getImage({
  src: socialImageSource,
  width: Math.min(1200, socialImageSource.width),
  format: "webp",
});
const socialImageUrl = Astro.site ? new URL(socialImage.src, Astro.site).href : socialImage.src;
const socialImageAlt = Astro.props.socialImageAlt
  ?? "An illustrated poetic landscape with poppies, skulls, the sea, and a setting sun";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe6" />
    <meta name="generator" content={Astro.generator} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(socialImage.attributes.width)} />
    <meta property="og:image:height" content={String(socialImage.attributes.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={language === "ru" ? "ru_RU" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href={copy.home}>{copy.headerTitle}</a>
        <nav class="language-switcher" aria-label={copy.languageLabel}>
          <a href={englishHref} aria-current={language === "en" ? "page" : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={russianHref} aria-current={language === "ru" ? "page" : undefined}>RU</a>
        </nav>
      </header>

      <slot />

      <footer class="site-footer">
        <nav class="footer-nav" aria-label={language === "ru" ? "Разделы сайта" : "Site sections"}>
          <a href={copy.home}>{copy.poems}</a>
          <a href={language === "ru" ? "/authors" : "/en/authors"}>{copy.authors}</a>
        </nav>
        <a href="#top">{copy.backTop}</a>
      </footer>
    </div>
  </body>
</html>
