---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Commonplace",
  description = "A quiet archive of poems and pieces worth returning to.",
} = Astro.props;

const pageTitle = title === "Commonplace" ? title : `${title} — Commonplace`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe6" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Commonplace home">Commonplace</a>
        <p>Words, kept close</p>
      </header>

      <slot />

      <footer class="site-footer">
        <p>A quiet place for language that lingers.</p>
        <a href="#top">Back to top ↑</a>
      </footer>
    </div>
  </body>
</html>
